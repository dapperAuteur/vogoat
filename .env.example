# Copy to .env.local and fill from plans/user-tasks/01-provision-infrastructure.md.
# NEVER commit .env.local. Claude does not read .env* files.

# === Database: Neon Postgres (task 01 step 2) ===
# Leave EMPTY in local development to use the zero-setup embedded Postgres (PGlite)
# stored in ./.data/pglite. Also read as fallbacks: STORAGE_DATABASE_URL /
# STORAGE_POSTGRES_URL (Vercel's Neon integration injects a STORAGE_ prefix).
DATABASE_URL=""

# === App ===
APP_URL="http://localhost:3050"

# === Auth: better-auth ===
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3050"
# Admin is bootstrapped by email at first sign-in; never hardcoded (invariant 7).
ADMIN_EMAIL=""

# === "Sign in with WitUS" ecosystem OIDC (task 01 step 4) ===
# Provider + button stay off until CLIENT_ID is set. Redirect URI the IdP must allow:
#   {BETTER_AUTH_URL}/api/auth/oauth2/callback/witus
# In development, with no client configured, a console magic link is offered instead.
WITUS_OIDC_CLIENT_ID=""
WITUS_OIDC_CLIENT_SECRET=""
# Optional override; defaults to https://accounts.witus.online/api/idp/.well-known/openid-configuration
WITUS_OIDC_DISCOVERY_URL=""

# === The shared daily ===
# The "VoGoat day" flips at 00:00 in this IANA zone for everyone (BAM, 2026-08-31: UTC).
DAILY_TIMEZONE="UTC"
# Day 1 of the public numbering ("VoGoat #1"). Fallback until launch is dated.
LAUNCH_DATE="2026-09-01"

# === Audio storage: Vercel Blob, private store (task 01 step 3) ===
# Leave empty locally to store kept takes under ./.data/blobs.
BLOB_READ_WRITE_TOKEN=""

# === Cron auth (Vercel sets this automatically when configured) ===
CRON_SECRET=""

# === Later phases ===
RESEND_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
