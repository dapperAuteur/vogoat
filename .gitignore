# deps / build
node_modules/
.next/
out/
.vercel/

# env — never commit secrets
.env
.env.*
!.env.example

# local working notes (ecosystem convention: plans/ is not committed)
plans/

# os / editor
.DS_Store
*.log

# local embedded database + local blob store (dev only)
.data/

# typescript build info
*.tsbuildinfo
next-env.d.ts

# playwright defaults, in case the suite is ever run without playwright.config.ts
# (its own artifacts land in .data/e2e/, already ignored above)
playwright-report/
test-results/
